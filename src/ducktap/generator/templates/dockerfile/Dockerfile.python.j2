# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the {{ cli_bin }} Python CLI (generated by DuckTap).
#
#   docker build -t {{ cli_bin }} .
#   docker run --rm {{ cli_bin }} --help
#
# The build stage installs the pinned dependency closure into an isolated
# virtualenv; the runtime stage copies only that venv, so no build tooling or
# caches ship in the final image.
FROM {{ build_image }} AS build

WORKDIR /build

COPY {{ requirements_copy }} ./
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir -r {{ requirements_file }}

COPY . .
RUN /opt/venv/bin/pip install --no-cache-dir --no-deps .

FROM {{ runtime_image }} AS runtime

COPY --from=build /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

{{ create_user }}
USER app
WORKDIR /home/app

ENTRYPOINT ["{{ cli_bin }}"]
CMD ["--help"]
