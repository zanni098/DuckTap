# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the {{ cli_bin }} Go CLI (generated by DuckTap).
#
#   docker build -t {{ cli_bin }} .
#   docker run --rm {{ cli_bin }} --help
#
# The binary is built statically (CGO disabled), so the runtime stage carries
# only the executable and CA certificates.
FROM {{ build_image }} AS build

{{ go_toolchain }}

WORKDIR /src

COPY . .
RUN go mod tidy \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/{{ cli_bin }} .

FROM {{ runtime_image }} AS runtime

{{ ca_install }}

COPY --from=build /out/{{ cli_bin }} /usr/local/bin/{{ cli_bin }}

USER 10001:10001
ENTRYPOINT ["{{ cli_bin }}"]
CMD ["--help"]
