# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the {{ cli_bin }} Rust CLI (generated by DuckTap).
#
#   docker build -t {{ cli_bin }} .
#   docker run --rm {{ cli_bin }} --help
#
# The release binary is built in a full toolchain image and copied into a
# minimal runtime image that carries only the executable and CA certificates.
FROM {{ build_image }} AS build

{{ rust_toolchain }}

WORKDIR /src

COPY Cargo.toml ./
COPY src ./src
RUN cargo build --release

FROM {{ runtime_image }} AS runtime

{{ ca_install }}

COPY --from=build /src/target/release/{{ rust_bin }} /usr/local/bin/{{ cli_bin }}

USER 10001:10001
ENTRYPOINT ["{{ cli_bin }}"]
CMD ["--help"]
